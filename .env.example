# ==============================================================================
# SentinelForge - Self-Hosted & Local Deployment Environment (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Copy this file to .env before starting SentinelForge with Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Service Ports (Host Bindings)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# PostgreSQL Database (Internal only - Not exposed publicly)
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=sentinelforge
POSTGRES_DB=sentinelforge
DATABASE_URL=postgresql+asyncpg://sentinelforge:sentinelforge@postgres:5432/sentinelforge

# Redis Cache & Token Revocation (Internal only - Not exposed publicly)
REDIS_URL=redis://redis:6379/0

# Backend Authentication (JWT)
# Generate a secure 256-bit random key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
