# ==============================================================================
# SentinelForge - Local Development Environment Variables (.env.example)
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local usage.
# ==============================================================================

# Database
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=sentinelforge
POSTGRES_DB=sentinelforge
DATABASE_URL=postgresql+asyncpg://sentinelforge:sentinelforge@localhost:5432/sentinelforge

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Backend Authentication (JWT)
# For production, generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
