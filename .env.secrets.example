# ==============================================================================
# SentinelForge - Kubernetes Operator Secrets Template (.env.secrets.example)
# WARNING: DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
#
# Copy this file to .env.secrets (ignored by git) and populate with your secure
# credentials, or let scripts/manage-secrets.sh generate them automatically.
# ==============================================================================

# PostgreSQL Credentials
# NOTE: If connecting to an existing PostgreSQL database or persistent volume (PVC),
# ensure POSTGRES_PASSWORD matches the existing database password.
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=sentinelforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Async Connection URL
# If left empty, scripts/manage-secrets.sh will auto-construct this from the above fields:
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=

# Backend JWT Authentication Configuration
# Generate a secure 256-bit random key (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_64_character_hex_or_base64_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
