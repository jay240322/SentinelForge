# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure shell scripts always retain LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Common text formats
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.py text eol=lf
*.sql text eol=lf

