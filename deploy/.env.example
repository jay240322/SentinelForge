# ==============================================================================
# SentinelForge - Self-Hosted Environment Template
#
# DO NOT USE THIS FILE AS-IS. It contains placeholders, not secrets.
#
# The recommended path is ./scripts/install.sh, which generates a complete
# environment file with cryptographically secure secrets and mode 0600.
#
# If you create the file manually:
#   cp .env.example .env
#   chmod 600 .env
#   # replace every placeholder below with a cryptographically secure value
#
# Generate values with:
#   openssl rand -hex 32
#
# POSTGRES_PASSWORD must be URL-safe (letters, digits, '.', '_', '~' or '-').
# PostgreSQL reads POSTGRES_PASSWORD only when initializing an empty volume.
# ==============================================================================

# Docker Compose project name (must not be changed after the first install).
COMPOSE_PROJECT_NAME=sentinelforge

# Public gateway (frontend + /api). Bind loopback unless a firewall is in front.
SENTINELFORGE_PORT=8080
SENTINELFORGE_BIND=127.0.0.1

# Container images. Pin immutable release tags for production use.
SENTINELFORGE_BACKEND_IMAGE=joypatel2403/sentinelforge-backend:latest
SENTINELFORGE_FRONTEND_IMAGE=joypatel2403/sentinelforge-frontend:latest
SENTINELFORGE_GATEWAY_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

# PostgreSQL (internal network only; do not publish these ports).
POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
POSTGRES_DB=sentinelforge

# Backend authentication.
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
